{
  "opencollection": "1.0.0",
  "info": {
    "name": "FastPix Data Simulcast API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Simulcast",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a simulcast target for a live stream",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.fastpix.io/v1/live/streams/:streamId/simulcast",
            "params": [
